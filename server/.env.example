# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vaultkey?retryWrites=true&w=majority

# Secret key for signing JWT authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# 32-byte secret key used for AES-256 vault credential encryption
ENCRYPTION_KEY=your_32_byte_hex_or_string_key_here

# Allowed frontend origin for CORS
CLIENT_URL=http://localhost:5173
